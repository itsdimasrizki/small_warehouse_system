# PlatformIO build artifacts & cache
.pio/
.pioenvs/
.piolibdeps/
.clangd/

# IDE & Editor files
.vscode/
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary & backup files
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# C/C++ compiled binaries
*.o
*.obj
*.elf
*.bin
*.hex
*.a
